{
	auto_https off
}

# Tailscale Serve terminates trusted HTTPS. This hop is plaintext only on the
# host loopback interface and remains unreachable from the LAN or tailnet.
http://:80 {
	@allowed path /v1/* /health
	handle @allowed {
		reverse_proxy backend:8000 {
			header_up X-LLMF-Gateway-Secret {$REMOTE_GATEWAY_SHARED_SECRET}
			header_up X-LLMF-Client-IP {http.request.remote.host}
			flush_interval -1
		}
	}

	handle {
		respond "Not found" 404
	}
}
