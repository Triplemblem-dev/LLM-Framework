# Copy this file to .env (same directory as docker-compose.yml) and fill
# in real values before running `docker compose up`. .env is gitignored -
# never commit real secrets.

# Postgres credentials for the docker-compose postgres service. This is a
# separate database from any native/dev Postgres install - fine to reuse
# the same values as backend/.env's DATABASE_URL if you want, but they
# don't have to match.
POSTGRES_USER=llmframework
POSTGRES_PASSWORD=
POSTGRES_DB=llmframework

# Bearer token the frontend and any API client must send. The graphical setup
# generates this automatically. For manual setup, use a password manager to
# generate a random value of at least 32 letters and numbers.
APP_ACCESS_TOKEN=

# Where the browser reaches the backend. On the same machine this stays
# localhost; on a real deployment this becomes whatever hostname/URL you
# actually access the server by (e.g. a Tailscale hostname).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match NEXT_PUBLIC_API_URL's origin (scheme+host+port) or the browser
# will block API calls with a CORS error. Comma-separate multiple origins
# if you need to.
CORS_ORIGINS=http://localhost:3000

# Only needed if you want the backend to use a native Ollama install
# instead of the bundled ollama container - e.g. on a Mac, where Docker
# cannot pass GPU/Metal access through to containers (see README.md).
# Leave unset to use the bundled container.
# OLLAMA_HOST=http://host.docker.internal:11434

# Optional conservative limits for local repository snapshot indexing.
# Values are bytes except member count, ratio, and result count.
# REPOSITORY_MAX_ARCHIVE_BYTES=104857600
# REPOSITORY_MAX_UNCOMPRESSED_BYTES=524288000
# REPOSITORY_MAX_MEMBERS=20000
# REPOSITORY_MAX_FILE_BYTES=2097152
# REPOSITORY_MAX_COMPRESSION_RATIO=100
# REPOSITORY_RESULT_LIMIT=8
# REPOSITORY_CHARACTER_LIMIT=12000

# Maximum context length the optimizer may benchmark, even when a model reports
# a larger native window. Per-run candidates are also clamped to the model.
# OPTIMIZER_CONTEXT_CEILING=65536
